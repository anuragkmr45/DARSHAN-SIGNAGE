# DARSHAN CMS env template.
# Copy to darshan-cms/.env only when you need build-time fallbacks.
#
# Keep env short. Public runtime values should normally live in:
#   darshan-cms/public/config/app-config.example.json
# deployed as:
#   /config/app-config.json
#
# Do not put secrets in CMS env or runtime config. Both are browser-visible.

# Optional runtime config path. Default is /config/app-config.json.
VITE_CMS_RUNTIME_CONFIG_PATH=/config/app-config.json

# Build-time fallback only, used if runtime config is absent.
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_BASE_URL=http://localhost:8080

# Optional labels/feature flags. Prefer runtime config where supported.
VITE_CMS_ENVIRONMENT_NAME=development
VITE_CMS_DEPLOYMENT_ID=local-dev
VITE_CMS_ID=cms-local
VITE_ENABLE_PRODUCTION_LOCKDOWN=false
VITE_REALTIME_DELIVERY_STATUS_UI=true
VITE_MEDIA_CACHE_STATUS_UI=true
