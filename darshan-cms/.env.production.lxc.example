# DARSHAN CMS public build defaults for 5 Proxmox LXCs.
# Copy to darshan-cms/.env if you want build-time values.
# The Proxmox CMS script also writes /config/app-config.json for runtime values.

VITE_API_BASE_URL=http://192.168.1.204:8080
VITE_WS_BASE_URL=http://192.168.1.204:8080
VITE_CMS_ENVIRONMENT_NAME=production
VITE_CMS_DEPLOYMENT_ID=site-a
VITE_CMS_ID=cms-a
VITE_CMS_RUNTIME_CONFIG_PATH=/config/app-config.json
VITE_ENABLE_PRODUCTION_LOCKDOWN=true
VITE_REALTIME_DELIVERY_STATUS_UI=true
VITE_MEDIA_CACHE_STATUS_UI=true
