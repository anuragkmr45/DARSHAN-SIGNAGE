server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  client_max_body_size 1000M;

  location /api/v1/ {
    proxy_pass https://${BACKEND_HOST}:${BACKEND_PORT}/api/v1/;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_ssl_name ${BACKEND_PRIVATE_HOST};
    proxy_ssl_trusted_certificate /etc/darshan/transport-ca.crt;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 2;
    proxy_set_header Host ${BACKEND_PRIVATE_HOST};
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /socket.io/ {
    proxy_pass https://${BACKEND_HOST}:${BACKEND_PORT}/socket.io/;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_ssl_name ${BACKEND_PRIVATE_HOST};
    proxy_ssl_trusted_certificate /etc/darshan/transport-ca.crt;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 2;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host ${BACKEND_PRIVATE_HOST};
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  # Keep SigV4 path/query/Host intact while the Backend owns a maintenance
  # permit for the complete browser-to-MinIO transfer.
  location ^~ /media-staging/ {
    if ($request_method != PUT) { return 405; }
    access_log off;
    proxy_pass https://${BACKEND_HOST}:${BACKEND_PORT};
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_ssl_name ${BACKEND_PRIVATE_HOST};
    proxy_ssl_trusted_certificate /etc/darshan/transport-ca.crt;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 2;
    proxy_set_header Host $http_host;
    proxy_set_header Cookie "";
    proxy_set_header Authorization "";
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location ^~ /media-source/ {
    if ($request_method !~ ^(GET|HEAD|PUT)$) { return 405; }
    access_log off;
    proxy_pass https://${BACKEND_HOST}:${BACKEND_PORT};
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_ssl_name ${BACKEND_PRIVATE_HOST};
    proxy_ssl_trusted_certificate /etc/darshan/transport-ca.crt;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 2;
    proxy_set_header Host $http_host;
    proxy_set_header Cookie "";
    proxy_set_header Authorization "";
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  # Browser media reads stay direct. Canonical/log/archive buckets reject PUT.
  location ~ ^/(?:media-ready|media-thumbnails|device-screenshots|logs-audit|logs-system|logs-auth|logs-heartbeats|logs-proof-of-play|archives)/ {
    if ($request_method !~ ^(GET|HEAD)$) { return 405; }
    access_log off;
    proxy_pass http://${MINIO_HOST}:${MINIO_PORT};
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header Cookie "";
    proxy_set_header Authorization "";
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location /grafana/ {
    proxy_pass http://${GRAFANA_HOST}:${GRAFANA_PORT}/grafana/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location ~* \.map$ {
    access_log off;
    return 404;
  }

  location = /config/app-config.json {
    add_header Cache-Control "no-store";
    try_files $uri =404;
  }

  # Vite gives static assets content hashes. They are safe to retain across a
  # release, while HTML and runtime configuration must always be revalidated.
  location ^~ /assets/ {
    try_files $uri =404;
    access_log off;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-store";
  }
}
