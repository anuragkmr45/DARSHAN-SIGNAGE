global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/darshan/prometheus/rules/*.yml

scrape_configs:
  - job_name: darshan-backend
    metrics_path: /metrics
    static_configs:
      - targets:
          - "__BACKEND_HOST__:__BACKEND_PORT__"

  - job_name: minio
    metrics_path: /minio/v2/metrics/cluster
    static_configs:
      - targets:
          - "__DATA_HOST__:__MINIO_PORT__"

  - job_name: prometheus
    static_configs:
      - targets:
          - "127.0.0.1:9090"
