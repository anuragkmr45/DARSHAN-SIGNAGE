# Docker-on-VM production deployment values.
# Copy to deploy/production/docker/.env on each production VM and edit host/IP values.
# Backend app secrets stay in darshan-server/.env on the Backend VM.
# Data-container bootstrap secrets stay here because Postgres and MinIO need them at startup.
#
# App behavior is controlled by short env files plus JSON config:
# - darshan-server/.env.example for secrets/sensitive URLs/selectors
# - darshan-server/config/backend.production.example.json for non-secret backend config
# - darshan-cms/.env.example for browser-visible build fallbacks
# - darshan-cms/public/config/app-config.example.json for CMS runtime config
#
# This file contains Docker topology, image names, and data-container bootstrap values.

DATA_HOST=192.168.0.6
MINIO_HOST=192.168.0.6
VALKEY_HOST=192.168.0.6
BACKEND_HOST=192.168.0.6
BACKEND_PRIVATE_HOST=192.168.0.6
BACKEND_BIND_ADDRESS=192.168.0.6
CMS_HOST=192.168.0.6
OBSERVABILITY_HOST=192.168.0.6

# Docker image names/tags. Each VM builds or pulls only the images needed by its role.
POSTGRES_IMAGE=postgres:15-alpine
MINIO_IMAGE=minio/minio:latest
VALKEY_IMAGE=valkey/valkey:7-alpine
BACKEND_IMAGE=darshan-server-api:production
CMS_IMAGE=darshan-cms:production
PROMETHEUS_IMAGE=prom/prometheus:v3.3.1
GRAFANA_IMAGE=grafana/grafana:12.0.2

# Docker data bootstrap values.
# The data VM uses POSTGRES_* to initialize Postgres.
# The data VM uses MINIO_ACCESS_KEY/MINIO_SECRET_KEY as MinIO root credentials.
# The backend VM uses the same MINIO_* values to access object storage.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=darshan
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Small-release local backup policy. The data VM retains every successful daily
# PostgreSQL + MinIO set for at least 30 full days and runs at midnight IST.
BACKUP_MODE=EXTERNAL_SIDECAR
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE_TIME=00:00
BACKUP_SCHEDULE_TIMEZONE=Asia/Kolkata
BACKUP_HOST_PATH=/var/lib/darshan/backups
SIMPLE_BACKUP_RETENTION_DAYS=30
SIMPLE_BACKUP_SCHEDULE_TIME=00:00
SIMPLE_BACKUP_TIMEZONE=Asia/Kolkata
SIMPLE_BACKUP_RETRY_SECONDS=3600
SIMPLE_BACKUP_MAX_AGE_SECONDS=129600
SIMPLE_BACKUP_MIN_FREE_BYTES=1073741824

POSTGRES_HOST_PORT=5432
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001
VALKEY_HOST_PORT=6379
API_HOST_PORT=3000
CMS_HTTP_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ROOT_URL=http://192.168.0.6:8080/grafana/

INSTALL_PLAYWRIGHT_CHROMIUM=true

# Explicit private site destinations only. Public addresses are blocked even
# when a hostname matches. Include each approved subnet and port.
WEBPAGE_NAVIGATION_ALLOWLIST=
WEBPAGE_RESOURCE_ALLOWLIST=
WEBPAGE_ALLOWED_CIDRS=
WEBPAGE_ALLOWED_PORTS=80,443
WEBPAGE_ALLOW_HTTP=false
WEBHOOK_TEST_ALLOWED_HOSTS=
WEBHOOK_TEST_ALLOWED_PORTS=80,443
WEBHOOK_TEST_ALLOWED_CIDRS=
TRUSTED_PROXY_CIDRS=

# Deprecated checkout backend compatibility requires real transport TLS even
# after the explicit acknowledgement gate in lib.sh. Normal production should
# use the generated source-free role bundle instead of this checkout flow.
SERVER_TLS_ENABLED=true
DATABASE_TLS_ENABLED=true
VALKEY_TLS_ENABLED=true
# Optional absolute host path when this script runs outside the repository
# checkout. If unset, lib.sh uses <repo>/darshan-server/certs/transport-ca.crt.
# DARSHAN_BACKEND_TRANSPORT_CA_FILE=/opt/darshan/current/backend/certs/transport-ca.crt

# Mounted into the CMS nginx image so URL changes do not require rebuilding the image.
CMS_RUNTIME_CONFIG_SOURCE=../../../../darshan-cms/public/config/app-config.json

PLAYER_BACKEND_BASE_URL=https://192.168.0.6:3000
PLAYER_SOCKET_IO_URL=https://192.168.0.6:3000/socket.io/
PLAYER_CONFIG_FILE_PATH=/etc/darshan/player/config.json
