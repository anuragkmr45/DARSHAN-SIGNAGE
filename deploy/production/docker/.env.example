# Docker Compose production/dev deployment values.
# Copy to deploy/production/docker/.env and edit for your machine/network.
# App secrets stay in darshan-server/.env unless the Docker data container also needs them.
#
# App behavior is controlled by short env files plus JSON config:
# - darshan-server/.env.example for secrets/sensitive URLs/selectors
# - darshan-server/config/backend.production.example.json for non-secret backend config
# - darshan-cms/.env.example for browser-visible build fallbacks
# - darshan-cms/public/config/app-config.example.json for CMS runtime config
#
# This file contains Docker topology plus data-container bootstrap values.

DATA_HOST=192.168.0.6
VALKEY_HOST=192.168.0.6
BACKEND_HOST=192.168.0.6
CMS_HOST=192.168.0.6
OBSERVABILITY_HOST=192.168.0.6

# Docker Postgres bootstrap values. The backend Docker service builds DATABASE_URL from these.
# For Proxmox/LXC, set DATABASE_URL directly in darshan-server/.env instead.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=darshan

POSTGRES_HOST_PORT=5432
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001
VALKEY_HOST_PORT=6379
API_HOST_PORT=3000
CMS_HTTP_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ROOT_URL=http://192.168.0.6:3001/grafana/

INSTALL_PLAYWRIGHT_CHROMIUM=true

PLAYER_BACKEND_BASE_URL=http://192.168.0.6:3000
PLAYER_SOCKET_IO_URL=http://192.168.0.6:3000/socket.io/
PLAYER_CONFIG_FILE_PATH=/etc/darshan/player/config.json
