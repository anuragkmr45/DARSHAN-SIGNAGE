[Unit]
Description=DARSHAN backend API and worker
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
WorkingDirectory=/opt/darshan/DARSHAN-SIGNAGE/darshan-server
EnvironmentFile=/etc/darshan/backend.env
Environment=NODE_ENV=production
Environment=HOST=0.0.0.0
Environment=PORT=3000
Environment=DARSHAN_PROCESS_ROLE=all
Environment=PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ExecStart=/usr/bin/env npm start
Restart=always
RestartSec=5
User=darshan
Group=darshan

[Install]
WantedBy=multi-user.target
