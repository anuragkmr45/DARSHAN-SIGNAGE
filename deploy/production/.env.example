# Non-secret role host/port overrides for production Docker.
# Copy to .env.local and edit for your machine/network.
# Secrets still stay in darshan-server/.env.

DATA_HOST=192.168.0.6
VALKEY_HOST=192.168.0.6
BACKEND_HOST=192.168.0.6
CMS_HOST=192.168.0.6
OBSERVABILITY_HOST=192.168.0.6

# Non-secret backend identity. Player config must use matching values.
SIGNHEX_ENVIRONMENT_NAME=production
SIGNHEX_DEPLOYMENT_ID=site-a
SIGNHEX_SERVER_ID=backend-a

POSTGRES_HOST_PORT=5432
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001
VALKEY_HOST_PORT=6379
API_HOST_PORT=3000
CMS_HTTP_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ROOT_URL=http://192.168.0.6:3001/grafana/

INSTALL_PLAYWRIGHT_CHROMIUM=true

# Player package/config reference values.
# These are non-secret operator references; the server-side compose scripts do not consume them.
# Put the actual player config file on each player machine, for example:
#   /etc/darshan/player/config.json
PLAYER_BACKEND_BASE_URL=http://192.168.0.6:3000
PLAYER_SOCKET_IO_URL=http://192.168.0.6:3000/socket.io/
PLAYER_CONFIG_FILE_PATH=/etc/darshan/player/config.json
