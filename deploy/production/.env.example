# DARSHAN Proxmox LXC production non-secret config.
# Copy to deploy/production/.env on the Proxmox host.
# Secrets stay in darshan-server/.env. CMS build/runtime public values can stay in darshan-cms/.env.
#
# App behavior is controlled by short env files plus JSON config:
# - darshan-server/.env.example for secrets/sensitive URLs/selectors
# - darshan-server/config/backend.production.example.json for non-secret backend config
# - darshan-cms/.env.example for browser-visible build fallbacks
# - darshan-cms/public/config/app-config.example.json for CMS runtime config
#
# This file should contain only Proxmox topology, service names, host/IP values,
# and non-secret deployment selectors.

# Proxmox CT IDs
DATA_CT_ID=201
VALKEY_CT_ID=202
BACKEND_CT_ID=203
CMS_CT_ID=204
OBSERVABILITY_CT_ID=205

# Static LXC IPs
DATA_HOST=192.168.1.201
VALKEY_HOST=192.168.1.202
BACKEND_HOST=192.168.1.203
CMS_HOST=192.168.1.204
OBSERVABILITY_HOST=192.168.1.205

# Ports exposed by system services inside the LXCs
POSTGRES_HOST_PORT=5432
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001
VALKEY_HOST_PORT=6379
API_HOST_PORT=3000
CMS_HTTP_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Public/proxy URLs
GRAFANA_ROOT_URL=http://192.168.1.204:8080/grafana/
PLAYER_BACKEND_BASE_URL=http://192.168.1.203:3000
PLAYER_SOCKET_IO_URL=http://192.168.1.203:3000/socket.io/
PLAYER_CONFIG_FILE_PATH=/etc/darshan/player/config.json

# Non-secret backend identity. Player config must use matching values.
SIGNHEX_ENVIRONMENT_NAME=production
SIGNHEX_DEPLOYMENT_ID=site-a
SIGNHEX_SERVER_ID=backend-a

# Paths inside LXCs
REMOTE_REPO_DIR=/opt/darshan/DARSHAN-SIGNAGE
BACKEND_APP_DIR=/opt/darshan/DARSHAN-SIGNAGE/darshan-server
CMS_APP_DIR=/opt/darshan/DARSHAN-SIGNAGE/darshan-cms
BACKEND_CONFIG_SOURCE=darshan-server/config/backend.production.example.json
BACKEND_CONFIG_PATH=/etc/darshan/server/config.json
CMS_WEB_ROOT=/usr/share/nginx/html
CMS_NGINX_CONFIG_PATH=/etc/nginx/conf.d/darshan-cms.conf
BACKEND_ENV_PATH=/etc/darshan/backend.env
PROMETHEUS_CONFIG_PATH=/etc/prometheus/prometheus.yml
PROMETHEUS_RULES_PATH=/etc/darshan/prometheus/rules
GRAFANA_PROVISIONING_PATH=/etc/grafana/provisioning
GRAFANA_DASHBOARDS_PATH=/var/lib/grafana/dashboards

# systemd unit names inside LXCs. Override if your distro package uses different names.
POSTGRES_SERVICE_NAME=postgresql
MINIO_SERVICE_NAME=minio
VALKEY_SERVICE_NAME=valkey
VALKEY_CLI_NAME=valkey-cli
BACKEND_SERVICE_NAME=darshan-backend
CMS_SERVICE_NAME=nginx
PROMETHEUS_SERVICE_NAME=prometheus
GRAFANA_SERVICE_NAME=grafana-server

# Runtime/build controls
INSTALL_PLAYWRIGHT_CHROMIUM=true
RUN_BACKEND_NPM_CI=true
RUN_CMS_NPM_CI=true
RUN_PRODUCTION_DB_PUSH=false
RUN_PRODUCTION_SEED=false

# CMS public runtime config generated into /config/app-config.json by start-cms.sh.
CMS_API_BASE_URL=http://192.168.1.204:8080
CMS_SOCKET_BASE_URL=http://192.168.1.204:8080
CMS_ID=cms-a
CMS_SHOW_ENVIRONMENT_IDENTITY=true
