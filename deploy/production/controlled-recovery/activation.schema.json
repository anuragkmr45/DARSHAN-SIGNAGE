{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darshan.invalid/schemas/controlled-recovery-activation-v1.json",
  "title": "DARSHAN controlled recovery Activation Packet A",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "enabled", "activation_mode", "non_production_acknowledgement", "site_id", "release", "docker", "source", "resources", "packet2", "report_authority", "limits"],
  "properties": {
    "format": { "const": "darshan-controlled-recovery-activation-v1" },
    "enabled": { "type": "boolean" },
    "activation_mode": { "enum": ["DISABLED", "TINY_DISPOSABLE_FIXTURE"] },
    "non_production_acknowledgement": { "const": "PACKET_A_HAS_NO_EFFECT_ADAPTER" },
    "site_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" },
    "release": { "type": "object", "additionalProperties": false, "required": ["release_id", "target_id", "terminal_migration_id", "migration_manifest_sha256", "profile", "assets_manifest", "recovery_runtime_manifest", "production_build_manifest"], "properties": { "release_id": { "const": "release-03" }, "target_id": { "const": "darshan-server-release-03-controlled" }, "terminal_migration_id": { "const": "0057_controlled_recovery_report_projection.sql" }, "migration_manifest_sha256": { "const": "05561d3b1c8cac7fa57f6d47503835d23c2b88f7886203ab9c8207238762c438" }, "profile": { "$ref": "#/$defs/asset" }, "assets_manifest": { "$ref": "#/$defs/asset" }, "recovery_runtime_manifest": { "$ref": "#/$defs/asset" }, "production_build_manifest": { "$ref": "#/$defs/asset" } } },
    "docker": { "type": "object", "additionalProperties": false, "required": ["executable", "config_identity", "context", "endpoint", "daemon_identity_sha256"], "properties": { "executable": { "$ref": "#/$defs/asset" }, "config_identity": { "$ref": "#/$defs/asset" }, "context": { "const": "darshan-controlled-recovery" }, "endpoint": { "const": "unix:///var/run/docker.sock" }, "daemon_identity_sha256": { "$ref": "#/$defs/sha256" } } },
    "source": { "type": "object", "additionalProperties": false, "required": ["repository_root", "manifest_keyring", "policy_keyring", "broker_socket", "recovery_key_root", "recipients"], "properties": { "repository_root": { "$ref": "#/$defs/absolutePath" }, "manifest_keyring": { "$ref": "#/$defs/asset" }, "policy_keyring": { "$ref": "#/$defs/asset" }, "broker_socket": { "$ref": "#/$defs/absolutePath" }, "recovery_key_root": { "$ref": "#/$defs/absolutePath" }, "recipients": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "object", "additionalProperties": false, "required": ["key_id", "recipient"], "properties": { "key_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" }, "recipient": { "type": "string", "pattern": "^age1[0-9a-z]{20,100}$" } } } } } },
    "resources": { "type": "object", "additionalProperties": false, "required": ["postgres", "minio", "importer", "validator"], "properties": { "postgres": { "$ref": "#/$defs/containerRole" }, "minio": { "$ref": "#/$defs/containerRole" }, "importer": { "$ref": "#/$defs/containerRole" }, "validator": { "$ref": "#/$defs/containerRole" } } },
    "packet2": { "type": "object", "additionalProperties": false, "required": ["profile", "fixed_overlay"], "properties": { "profile": { "$ref": "#/$defs/asset" }, "fixed_overlay": { "$ref": "#/$defs/asset" } } },
    "report_authority": { "type": "object", "additionalProperties": false, "required": ["public_keyring", "active_key_id"], "properties": { "public_keyring": { "$ref": "#/$defs/asset" }, "active_key_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" } } },
    "limits": { "type": "object", "additionalProperties": false, "required": ["command_timeout_ms", "stdout_max_bytes", "stderr_max_bytes"], "properties": { "command_timeout_ms": { "type": "integer", "minimum": 1, "maximum": 86400000 }, "stdout_max_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 }, "stderr_max_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 } } }
  },
  "$defs": {
    "absolutePath": { "type": "string", "pattern": "^/", "maxLength": 1024 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decimal": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "asset": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "$ref": "#/$defs/absolutePath" }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "containerRole": { "type": "object", "additionalProperties": false, "required": ["image", "user", "entrypoint", "command", "memory_bytes", "nano_cpus", "pids_limit", "read_only_root", "no_new_privileges", "cap_drop_all"], "properties": { "image": { "type": "string", "pattern": "@sha256:[a-f0-9]{64}$" }, "user": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" }, "entrypoint": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 256 } }, "command": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 256 } }, "memory_bytes": { "$ref": "#/$defs/decimal" }, "nano_cpus": { "$ref": "#/$defs/decimal" }, "pids_limit": { "type": "integer", "minimum": 1, "maximum": 4096 }, "read_only_root": { "const": true }, "no_new_privileges": { "const": true }, "cap_drop_all": { "const": true } } }
  }
}
