# DARSHAN source-free production bundle configuration.
#
# Copy this file to deploy/production/bundles/<site>-<release>.env and edit only
# that private copy. Relative paths resolve from the DARSHAN-SIGNAGE repo root.
# Create persistent CA files once with scripts/bootstrap/create-site-pki.sh.

RELEASE_ID=2026-08-23-r1
SITE_NAME=site-a

# Build released packages from this checkout. Player installers from other
# native build machines can be collected below without changing source config.
EXPORT_SERVER=true
EXPORT_CMS=true
EXPORT_ELECTRON=false
ELECTRON_PLATFORM=linux
# Bundle player installers to include. Use linux until a Windows installer is available.
PLAYER_TARGET_PLATFORMS=windows,linux
INSTALL_PLAYWRIGHT_CHROMIUM=true
# These paths are resolved from the DARSHAN-SIGNAGE repository root. Keep them
# relative for a portable checkout; use an absolute path only for another disk.
PACKAGE_OUTPUT_BASE=out
BUNDLE_OUTPUT_BASE=dist/onprem
# Fresh sites create stable, explicitly named external volumes. Existing sites
# must use require-existing and inventory every actual Docker volume name.
# These are the defaults for SITE_NAME=site-a. They are optional with create,
# but must be uncommented with the exact deployed names for require-existing.
VOLUME_PROVISIONING_MODE=create
# POSTGRES_VOLUME_NAME=darshan-site-a-postgres-data
# MINIO_VOLUME_NAME=darshan-site-a-minio-data
# VALKEY_VOLUME_NAME=darshan-site-a-valkey-data
# PROMETHEUS_VOLUME_NAME=darshan-site-a-prometheus-data
# ALERTMANAGER_VOLUME_NAME=darshan-site-a-alertmanager-data
# GRAFANA_VOLUME_NAME=darshan-site-a-grafana-data
# SERVER_PACKAGE_DIR and CMS_PACKAGE_DIR default to out/<RELEASE_ID>/{server,cms}.
# When EXPORT_ELECTRON=false, point PLAYER_ARTIFACTS_DIR at a staging directory
# containing the installer types selected by PLAYER_TARGET_PLATFORMS.
PLAYER_ARTIFACTS_DIR=out/2026-08-23-r1/electron

# VM addresses. Use an IPv4 address or a DNS name without scheme or port.
CMS_PUBLIC_HOST=10.20.0.30
BACKEND_PRIVATE_HOST=10.20.0.20
BACKEND_DEVICE_HOST=10.20.0.20
DATA_PRIVATE_HOST=10.20.0.10
VALKEY_PRIVATE_HOST=10.20.0.15
OBSERVABILITY_PRIVATE_HOST=10.20.0.40

# Exact local IPv4 interfaces on the target VMs used for Docker port
# publication. They deliberately cannot be 0.0.0.0 or loopback. The backend
# address must be reachable from both the CMS and player networks; DNS service
# names may differ, but must route to this bound interface.
CMS_BIND_ADDRESS=10.20.0.30
BACKEND_BIND_ADDRESS=10.20.0.20
DATA_BIND_ADDRESS=10.20.0.10
VALKEY_BIND_ADDRESS=10.20.0.15
OBSERVABILITY_BIND_ADDRESS=10.20.0.40

# Optional sixth on-prem VM for scheduled LIVE media. Default false preserves
# the existing five-VM bundle. No live credentials/epoch/TLS key enter a bundle.
INCLUDE_LIVE_MEDIA=false
EXPORT_MEDIA=true
# MEDIA_PACKAGE_DIR=out/<release>/media
# MEDIA_IMAGE=darshan-media:<release>
# MEDIA_PRIVATE_HOST=media.site.example
# MEDIA_BIND_ADDRESS=10.20.0.60
# MEDIA_CONTROL_PORT=18784
# MEDIA_SIGNAL_PORT=18780
# MEDIA_RTC_TCP_PORT=18782
# MEDIA_RTC_UDP_PORT=18783
# Resource limits are site decisions, not approved sizing defaults.
# MEDIA_CPU_LIMIT=4
# MEDIA_MEMORY_LIMIT=4g
# MEDIA_PIDS_LIMIT=512
# MEDIA_MIN_FREE_DISK_BYTES=10737418240

# One switch controls the complete production HTTPS path. internal-ca creates
# role leaf certificates from a persistent site CA. provided consumes all leafs.
TRANSPORT_TLS_MODE=internal-ca
PKI_ROOT_DIR=/secure/darshan-pki
# Protected build-machine paths. PKI_ROOT_DIR contains one subdirectory per
# site; measured mode uses an approved CAPACITY_EVIDENCE_FILE. A temporary
# owner-approved waiver must be explicit, time-limited, and never presented as
# measured evidence.
# The release key is readable only by the controlled build user and is never
# copied into the runtime bundle.
RELEASE_SIGNING_PRIVATE_KEY=/secure/darshan-signing/release-signing.key

# Required only for TRANSPORT_TLS_MODE=provided.
# By default, provided mode reads cms.*, backend.*, minio.*, postgres.*, and valkey.* from
# PKI_ROOT_DIR/<SITE_NAME>. Override individual *_TLS_*_FILE keys only if paths differ.

CMS_HTTPS_PORT=443
CMS_HTTP_PORT=80
API_HOST_PORT=3000
POSTGRES_HOST_PORT=5432
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001
VALKEY_HOST_PORT=6379
PROMETHEUS_HOST_PORT=9090
ALERTMANAGER_HOST_PORT=9093
GRAFANA_HOST_PORT=3001
NODE_EXPORTER_HOST_PORT=9100
POSTGRES_EXPORTER_HOST_PORT=9187
NGINX_EXPORTER_HOST_PORT=9113

# Replace every core-service credential in the private copy. Those values are
# not requested again on a target VM. LIVE authority/control/witness/signing
# credentials are deliberately generated/provisioned on targets, never bundled.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-with-at-least-12-characters
# Dedicated non-superuser credential used only by postgres_exporter. It is
# written as a protected file on the data role, never into a runtime env file.
POSTGRES_MONITORING_USER=darshan_monitoring
POSTGRES_MONITORING_PASSWORD=change-me-with-at-least-24-random-characters
POSTGRES_DB=darshan
VALKEY_PASSWORD=change-me-with-at-least-24-random-characters
OBSERVABILITY_METRICS_BEARER_TOKEN=change-me-with-at-least-32-random-characters
# Grafana uses these only on its first database initialization. The password
# is delivered to the container through a protected file, never `.env.production`.
GRAFANA_ADMIN_USER=darshan-admin
GRAFANA_ADMIN_PASSWORD=change-me-with-at-least-24-random-characters
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me-with-at-least-16-characters
MINIO_REGION=us-east-1
JWT_SECRET=change-me-with-at-least-32-random-characters
JWT_EXPIRY=900
# The password is deliberately not part of this bundle configuration. Create
# production/backend/bootstrap-secrets/admin-password (mode 0600) on the
# Backend VM before the first start; see production/backend/secrets/README.md.
INITIAL_ADMIN_EMAIL=admin@example.local
LOG_LEVEL=info
MAX_UPLOAD_MB=500
WEBPAGE_NAVIGATION_ALLOWLIST=*
# "*" means any public HTTP or HTTPS hostname after SSRF/DNS/port checks. Add a narrower
# list for locked-down sites.
WEBPAGE_RESOURCE_ALLOWLIST=*
WEBPAGE_ALLOWED_CIDRS=
WEBPAGE_ALLOWED_PORTS=80,443
WEBPAGE_ALLOW_HTTP=true
WEBPAGE_PREVIEW_REFRESH_INTERVAL_HOURS=24
WEBPAGE_PREVIEW_REFRESH_BATCH_SIZE=100

# Required production operations policy. These values are intentionally not
# defaulted: size each VM after the approved hardware/load profile and name an
# independently operated backup target. The build config is private input, so
# the off-host access credentials below are written only to protected Backend
# role secret files; they are never added to a runtime environment file.
# Absolute protected build-machine path to the approved measured-capacity JSON.
CAPACITY_VALIDATION_MODE=measured
CAPACITY_EVIDENCE_FILE=/secure/darshan-evidence/site-a-2026-08-23-r1-capacity.json
# Alternative for a deliberately waived first deployment (maximum 90 days):
# CAPACITY_VALIDATION_MODE=waived
# CAPACITY_EVIDENCE_FILE=
# CAPACITY_WAIVER_APPROVED_BY=Site Project Owner
# CAPACITY_WAIVER_REASON=Initial internal deployment with measured capacity testing deferred
# CAPACITY_WAIVER_EXPIRES_AT=2026-12-01T00:00:00+05:30
MAXIMUM_EXPECTED_PLAYERS=change-me
TEMPORARY_SPIKE_PLAYERS=change-me
BACKUP_MODE=APPLICATION_OFFHOST
BACKUP_INTERVAL_HOURS=change-me
BACKUP_RETENTION_DAYS=change-me
BACKUP_OFFHOST_DESTINATION=s3://replace-with-offhost-backup-endpoint/darshan/site-a
BACKUP_OFFHOST_ENDPOINT=https://replace-with-offhost-s3-endpoint.example
BACKUP_OFFHOST_REGION=us-east-1
BACKUP_OFFHOST_ACCESS_KEY=change-me
BACKUP_OFFHOST_SECRET_KEY=change-me-with-at-least-16-characters
# For an explicitly accepted Data-VM-only backup risk, replace the off-host
# fields above with BACKUP_MODE=EXTERNAL_SIDECAR and these values. The host
# path must end in the exact SITE_NAME. This mode does not satisfy Data-VM or
# disk-loss RPO and requires separate release-risk acceptance.
# BACKUP_SCHEDULE_TIME=00:00
# BACKUP_SCHEDULE_TIMEZONE=Asia/Kolkata
# BACKUP_RETRY_SECONDS=3600
# BACKUP_MAX_AGE_SECONDS=129600
# BACKUP_MIN_FREE_BYTES=1073741824
# BACKUP_HOST_PATH=/var/lib/darshan/backups/site-a
CONTAINER_LOG_MAX_SIZE=change-me
CONTAINER_LOG_MAX_FILES=change-me
DATA_MIN_FREE_DISK_BYTES=change-me
VALKEY_MIN_FREE_DISK_BYTES=change-me
BACKEND_MIN_FREE_DISK_BYTES=change-me
CMS_MIN_FREE_DISK_BYTES=change-me
OBSERVABILITY_MIN_FREE_DISK_BYTES=change-me

# Each value is a Docker Compose runtime ceiling, not a VM recommendation.
# CPU is a decimal count; memory uses m or g; PIDs is an integer.
POSTGRES_CPU_LIMIT=change-me
POSTGRES_MEMORY_LIMIT=change-me
POSTGRES_PIDS_LIMIT=change-me
MINIO_CPU_LIMIT=change-me
MINIO_MEMORY_LIMIT=change-me
MINIO_PIDS_LIMIT=change-me
# Required only for BACKUP_MODE=EXTERNAL_SIDECAR.
# BACKUP_CPU_LIMIT=change-me
# BACKUP_MEMORY_LIMIT=change-me
# BACKUP_PIDS_LIMIT=change-me
VALKEY_CPU_LIMIT=change-me
VALKEY_MEMORY_LIMIT=change-me
VALKEY_PIDS_LIMIT=change-me
BACKEND_API_CPU_LIMIT=change-me
BACKEND_API_MEMORY_LIMIT=change-me
BACKEND_API_PIDS_LIMIT=change-me
BACKEND_WORKER_CPU_LIMIT=change-me
BACKEND_WORKER_MEMORY_LIMIT=change-me
BACKEND_WORKER_PIDS_LIMIT=change-me
CMS_CPU_LIMIT=change-me
CMS_MEMORY_LIMIT=change-me
CMS_PIDS_LIMIT=change-me
PROMETHEUS_CPU_LIMIT=change-me
PROMETHEUS_MEMORY_LIMIT=change-me
PROMETHEUS_PIDS_LIMIT=change-me
ALERTMANAGER_CPU_LIMIT=change-me
ALERTMANAGER_MEMORY_LIMIT=change-me
ALERTMANAGER_PIDS_LIMIT=change-me
GRAFANA_CPU_LIMIT=change-me
GRAFANA_MEMORY_LIMIT=change-me
GRAFANA_PIDS_LIMIT=change-me
# Covers node/postgres/nginx exporters. It must be sufficient on every role.
EXPORTER_CPU_LIMIT=change-me
EXPORTER_MEMORY_LIMIT=change-me
EXPORTER_PIDS_LIMIT=change-me

# Fresh production sites use signed device requests only. For an existing fleet
# during a controlled player upgrade, set DEVICE_AUTH_MODE=dual and provide a
# finite, future UTC expiry. Promotion to signature requires the rollout-status
# evidence check documented in the production deployment runbook.
DEVICE_AUTH_MODE=signature
# DEVICE_AUTH_MODE=dual
# DEVICE_AUTH_LEGACY_COMPATIBILITY_EXPIRES_AT=2026-09-30T12:00:00Z

# Explicit values make the CMS build independent of local shell and .env files.
VITE_ENABLE_PRODUCTION_LOCKDOWN=true
VITE_REALTIME_DELIVERY_STATUS_UI=true
VITE_MEDIA_CACHE_STATUS_UI=true
