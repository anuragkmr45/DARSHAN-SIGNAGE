{
  "environment": {
    "name": "production",
    "deploymentId": "render-cloud",
    "serverId": "darshan-cloud-api"
  },
  "realtime": {
    "enabled": true,
    "busProvider": "valkey",
    "socketTransport": "websocket",
    "socketAllowPolling": true,
    "socketRequireStickySessions": false,
    "deviceNamespace": "/device",
    "wsPingIntervalMs": 25000,
    "wsIdleTimeoutMs": 75000
  },
  "valkey": {
    "mode": "standalone",
    "tlsEnabled": true,
    "authRequired": true,
    "caCertPath": "/etc/ssl/certs/ca-certificates.crt",
    "namespace": "darshan:cloud",
    "pubsubEnabled": true,
    "deviceNodeTtlMs": 120000,
    "reconnectMinMs": 500,
    "reconnectMaxMs": 30000,
    "publishTimeoutMs": 2000
  },
  "duplicateIdentity": {
    "enabled": true,
    "enforcement": "block",
    "sessionLeaseMs": 300000,
    "restartGraceMs": 120000
  },
  "security": {
    "authCookieSecure": true,
    "csrfEnabled": true,
    "loginMaxAttempts": 5,
    "loginLockoutWindowSeconds": 900,
    "loginThrottleProvider": "valkey",
    "loginThrottleFailClosed": true,
    "maxUploadMb": 500,
    "storageQuotaBytes": 8589934592,
    "swaggerUiEnabled": false
  },
  "deviceSocketAuth": {
    "legacyAllowed": false,
    "signedEnabled": true,
    "maxClockSkewMs": 300000,
    "replayProtectionEnabled": true,
    "replayCacheTtlMs": 300000,
    "replayFailClosed": true
  },
  "commands": {
    "leaseMs": 60000,
    "maxAttempts": 5,
    "defaultExpiresMs": 86400000,
    "emergencyExpiresMs": 300000,
    "outboxWriteEnabled": true,
    "desiredStateEnabled": true
  },
  "outbox": {
    "dispatchEnabled": true,
    "batchSize": 100,
    "dispatchIntervalMs": 1000,
    "dispatchLeaseMs": 60000
  },
  "media": {
    "region": "auto",
    "forcePathStyle": true,
    "cacheReportingEnabled": true
  },
  "observability": {
    "prometheusTimeoutMs": 1500,
    "grafanaEnabled": false,
    "grafanaEmbedEnabled": false,
    "grafanaBasePath": "/grafana"
  },
  "limits": {
    "wsNotificationMaxBytes": 32768
  }
}
