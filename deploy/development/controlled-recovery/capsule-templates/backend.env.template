NODE_ENV=production
DARSHAN_D3=1
DARSHAN_PROCESS_ROLE=api
DARSHAN_D3_BACKUP_WORKER_AVAILABLE=false
DARSHAN_D3_BACKUP_WORKER_BLOCKER=NATIVE_PINNED_AGE_AUTHORITY_NOT_ENROLLED
__MAPPED_ENV__
HOST=127.0.0.1
PORT=18441
DEVICE_PORT=18442
DATABASE_URL_FILE=/run/secrets/database-url
DATABASE_TLS_ENABLED=true
DATABASE_CA_CERT_PATH=/app/certs/transport-ca.crt
JWT_SECRET_FILE=/run/secrets/jwt-secret
MINIO_ACCESS_KEY_FILE=/run/secrets/minio-access-key
MINIO_SECRET_KEY_FILE=/run/secrets/minio-secret-key
VALKEY_URL_FILE=/run/secrets/valkey-url
SERVER_TLS_ENABLED=true
TLS_CERT_PATH=/app/certs/server.crt
TLS_KEY_PATH=/app/certs/server.key
CA_CERT_PATH=/app/certs/device-ca.crt
CA_KEY_PATH=/app/certs/device-ca.key
NODE_EXTRA_CA_CERTS=/app/certs/transport-ca.crt
OBSERVABILITY_METRICS_BEARER_TOKEN_FILE=/run/secrets/observability-metrics-bearer-token
DEVICE_AUTH_MODE=signature
DEVICE_SOCKET_LEGACY_AUTH_ALLOWED=false
DEVICE_SOCKET_SIGNED_AUTH_ENABLED=true
DEVICE_SOCKET_AUTH_REPLAY_PROTECTION_ENABLED=true
DEVICE_SOCKET_AUTH_REPLAY_FAIL_CLOSED=true
DARSHAN_RELEASE_ID=release-03
DARSHAN_SOURCE_COMMIT=development
DARSHAN_COMPATIBILITY_GENERATION=3
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_LOCAL_PROTOCOL=V2_BROKER
