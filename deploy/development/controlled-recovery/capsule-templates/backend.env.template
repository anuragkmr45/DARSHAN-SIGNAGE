BACKUP_SCHEDULE_TIME=02:00
BACKUP_SCHEDULE_TIMEZONE=UTC
BACKUP_REPOSITORY_KIND=LOCAL_FILESYSTEM
BACKUP_REPOSITORY_ROOT=__REPOSITORY_ROOT__
BACKUP_REPOSITORY_ID=d3000000-0000-4000-8000-000000000002
BACKUP_REPOSITORY_DEVICE_ID=__SCOPE_DEVICE__
BACKUP_REPOSITORY_OWNER_UID=__OWNER_UID__
BACKUP_REPOSITORY_OWNER_GID=__OWNER_GID__
BACKUP_REPOSITORY_MIN_FREE_BYTES=1073741824
BACKUP_ENCRYPTION_RECIPIENT=__AGE_RECIPIENT__
BACKUP_ENCRYPTION_KEY_ID=__AGE_KEY_ID__
BACKUP_BROKER_SOCKET_PATH=__ROOT__/run/backup-broker.sock
BACKUP_BROKER_HELPER_VERSION=d3-v1
BACKUP_MANIFEST_PUBLIC_KEYRING_PATH=__ROOT__/capsule/public/manifest-keyring.json
BACKUP_POLICY_PUBLIC_KEYRING_PATH=__ROOT__/capsule/public/policy-trust.json
BACKUP_WORKER_SPOOL_ROOT=__ROOT__/spool
BACKUP_WORKER_SPOOL_DEVICE_ID=__SCOPE_DEVICE__
