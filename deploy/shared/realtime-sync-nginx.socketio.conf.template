# Signhex realtime sync reverse-proxy snippet.
# Include these locations in the CMS/backend-facing server block and replace
# __BACKEND_UPSTREAM_HOST__ and __BACKEND_UPSTREAM_PORT__ during packaging.
#
# Architecture guardrails:
# - /api/v1/ is authoritative REST.
# - /socket.io/ is notification-only WebSocket/Engine.IO transport.
# - Do not cache device command, desired-state, heartbeat, ACK, or status APIs.
# - Do not send snapshots, media, screenshots, logs, or PoP over WebSocket.

location /api/v1/ {
  proxy_pass http://__BACKEND_UPSTREAM_HOST__:__BACKEND_UPSTREAM_PORT__/api/v1/;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_read_timeout 75s;
  proxy_send_timeout 75s;
  proxy_buffering off;
  add_header Cache-Control "no-store" always;
}

location /socket.io/ {
  proxy_pass http://__BACKEND_UPSTREAM_HOST__:__BACKEND_UPSTREAM_PORT__/socket.io/;
  proxy_http_version 1.1;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_read_timeout 90s;
  proxy_send_timeout 90s;
  proxy_buffering off;
  add_header Cache-Control "no-store" always;
}

# Multi-instance note:
# Phase 3 uses a process-local device connection registry. Multi-instance deployments
# require sticky sessions for /socket.io/ or a distributed registry/fanout layer before
# full-fleet realtime enablement.
