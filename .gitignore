# Dependencies
node_modules/

# Lockfiles intentionally not used by these components. The Backend
# package-lock.json is deliberately tracked for reproducible npm ci builds.
/darshan-player/package-lock.json
/darshan-player/yarn.lock
/darshan-server/yarn.lock
/darshan-server/pnpm-lock.yaml

# Build and package output
dist/
out/
build/
dist-ssr/
/darshan-server/dist-cli/
/darshan-server/dist-production/
*.tsbuildinfo
*.tar
*.tgz
*.zip
*.SKIPPED.txt

# Environment and generated deployment configuration
/darshan-server/.env
/darshan-server/.env.local
/darshan-server/.env.*.local
/darshan-player/.env
/darshan-player/.env.local
/darshan-player/.env.*.local
/darshan-cms/.env
