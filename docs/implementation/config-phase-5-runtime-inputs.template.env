# CONFIG-5 runtime evidence input template.
#
# This file is a template only. Do not fill it with real values in git.
# Copy it to a local ignored path such as:
#
#   .local/config5-runtime.env
#
# Then export/source that local file in your shell before running CONFIG-5 readiness
# checks. `.local/` is gitignored.
#
# Sensitive values:
# - `ONPREM_POSTGRES_URL` and `ONPREM_VALKEY_URL` usually contain passwords.
# - `ONPREM_DEVICE_SIMULATOR_CREDENTIAL_POOL_PATH`, CA paths, log paths, and
#   player machine/runtime roots may reveal site topology.
# - Do not paste secret values into tickets, screenshots, committed docs, or chat.

ONPREM_QA_BACKEND_BASE_URL=
ONPREM_QA_CMS_BASE_URL=
ONPREM_QA_SOCKET_IO_URL=

ONPREM_POSTGRES_URL=
ONPREM_VALKEY_URL=
ONPREM_MEDIA_ENDPOINT=

ONPREM_PROMETHEUS_URL=
ONPREM_GRAFANA_URL=
ONPREM_LOGS_PATH=

ONPREM_QA_DEVICE_PAIRING_METHOD=
ONPREM_DEVICE_SIMULATOR_CREDENTIAL_POOL_PATH=

ONPREM_INTERNAL_CA_CERT_PATH=
ONPREM_TLS_MODE=

ONPREM_PLAYER_PACKAGE_PATH=
ONPREM_PLAYER_MACHINE_A=
ONPREM_PLAYER_MACHINE_B=
ONPREM_PLAYER_RUNTIME_ROOT_A=
ONPREM_PLAYER_RUNTIME_ROOT_B=

