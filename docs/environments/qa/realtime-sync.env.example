# DARSHAN on-prem QA realtime sync environment checklist
# Values are examples. Do not store secrets in this file.

# On-prem/internal endpoints. Use intranet DNS names or private IPs only.
ONPREM_DEV_BACKEND_BASE_URL=
ONPREM_DEV_CMS_BASE_URL=
ONPREM_DEV_SOCKET_IO_URL=
ONPREM_QA_BACKEND_BASE_URL=http://10.30.0.20:3000
ONPREM_QA_CMS_BASE_URL=http://10.30.0.30
ONPREM_QA_SOCKET_IO_URL=ws://10.30.0.20:3000/socket.io/

# On-prem network and TLS.
ONPREM_NETWORK_NAME=
ONPREM_DNS_ZONE=
ONPREM_TLS_MODE=internal-ca
ONPREM_CA_CERT_PATH=
ONPREM_PROXY_TYPE=nginx
ONPREM_LB_MODE=single-node

# Backend: source-of-truth REST, command lifecycle, desired state, and outbox writes.
COMMAND_LEASE_MS=60000
COMMAND_MAX_ATTEMPTS=5
COMMAND_DEFAULT_EXPIRES_MS=86400000
COMMAND_EMERGENCY_EXPIRES_MS=300000
COMMAND_OUTBOX_WRITE_ENABLED=true
DEVICE_DESIRED_STATE_ENABLED=true
DARSHAN_MEDIA_CACHE_REPORTING_ENABLED=true

# Backend: notification-only WebSocket gateway and outbox dispatcher.
# Keep disabled until QA proxy smoke passes, then enable for canary only.
REALTIME_SYNC_ENABLED=false
REALTIME_DEVICE_NAMESPACE=/device
REALTIME_WS_PATH=/socket.io/
REALTIME_WS_PING_INTERVAL_MS=25000
REALTIME_WS_IDLE_TIMEOUT_MS=75000
WS_NOTIFICATION_MAX_BYTES=32768
REALTIME_SOCKET_TRANSPORT=websocket
REALTIME_SOCKET_ALLOW_POLLING=false
REALTIME_SOCKET_REQUIRE_STICKY_SESSIONS=false
# Signed /device socket auth canary keeps the backend dual-mode.
# Signed auth remains optional; legacy socket auth stays available for deployed players.
DEVICE_SOCKET_LEGACY_AUTH_ALLOWED=true
DEVICE_SOCKET_SIGNED_AUTH_ENABLED=true
DEVICE_SOCKET_AUTH_MAX_CLOCK_SKEW_MS=300000
# Signed socket replay protection uses Valkey when configured; fail-open preserves rollback safety.
# Keep fail-closed off during canary unless a reviewed runtime plan explicitly approves it.
DEVICE_SOCKET_AUTH_REPLAY_PROTECTION_ENABLED=true
DEVICE_SOCKET_AUTH_REPLAY_CACHE_TTL_MS=300000
DEVICE_SOCKET_AUTH_REPLAY_FAIL_CLOSED=false
REALTIME_NODE_ID=
REALTIME_DEVICE_NODE_TTL_MS=120000
REALTIME_VALKEY_RECONNECT_MIN_MS=500
REALTIME_VALKEY_RECONNECT_MAX_MS=30000
REALTIME_VALKEY_PUBLISH_TIMEOUT_MS=1000
OUTBOX_DISPATCH_ENABLED=false
OUTBOX_DISPATCH_BATCH_SIZE=100
OUTBOX_DISPATCH_INTERVAL_MS=1000
OUTBOX_DISPATCH_LEASE_MS=30000

# Backend: on-prem multi-node realtime bus.
# Valkey is the preferred on-prem fanout/coordination layer.
# DB command_outbox remains durable truth; Valkey Pub/Sub is wake notification only.
REALTIME_BUS_PROVIDER=valkey
VALKEY_URL=
VALKEY_MODE=standalone
VALKEY_TLS_ENABLED=false
VALKEY_AUTH_REQUIRED=true
VALKEY_CA_CERT_PATH=
VALKEY_NAMESPACE=darshan:qa
VALKEY_PUBSUB_ENABLED=true
VALKEY_STREAMS_ENABLED=false
VALKEY_MAXMEMORY_POLICY=noeviction
VALKEY_HA_TOPOLOGY=single-node

# Backward compatibility only. New deployments should prefer VALKEY_URL.
REDIS_URL=
REDIS_URL_ALIAS_FOR_VALKEY=true

# On-prem database and media storage.
ONPREM_POSTGRES_URL=
ONPREM_MINIO_OR_OBJECT_STORAGE_ENDPOINT=http://10.30.0.10:9000
ONPREM_MEDIA_BASE_URL=http://10.30.0.10:9000
ONPREM_MEDIA_STORAGE_MODE=minio

# CMS build-time flags.
VITE_REALTIME_DELIVERY_STATUS_UI=true
VITE_MEDIA_CACHE_STATUS_UI=true

# Player/runtime flags.
# Keep realtime disabled until the QA backend and proxy smoke checks pass.
# Enable signed socket auth only in selected canary player config after the player has credentials.
DARSHAN_REALTIME_PLAYER_ENABLED=false
DARSHAN_REALTIME_SIGNED_AUTH_ENABLED=false
DARSHAN_REALTIME_DEVICE_NAMESPACE=/device
DARSHAN_REALTIME_WS_URL=ws://10.30.0.20:3000/socket.io/
DARSHAN_REALTIME_COMMAND_SAFETY_POLL_MS=60000
DARSHAN_REALTIME_FALLBACK_POLL_MS=30000
DARSHAN_REALTIME_DESIRED_STATE_POLL_MS=300000
DARSHAN_WS_NOTIFICATION_MAX_BYTES=32768
# Legacy HEXMON_* player variables remain supported as one-release aliases.

# On-prem simulator/load and runtime review inputs.
ONPREM_DEVICE_SIMULATOR_CREDENTIAL_POOL_PATH=
ONPREM_LOAD_TEST_MAX_PLAYERS=
ONPREM_LOAD_TEST_PROFILES_ALLOWED=current,hybrid-healthy,fallback
ONPREM_LOAD_TEST_WINDOW=
ONPREM_CHAOS_TEST_WINDOW=
ONPREM_ALLOWED_FAILURE_INJECTIONS=
NODE_VERSION=20.x
ONPREM_MIGRATION_REVIEW_TARGET=
MEDIA_CACHE_REPORT_RETENTION_DAYS=
MEDIA_CACHE_REPORT_AGGREGATE_RETENTION_DAYS=

# On-prem observability.
ONPREM_PROMETHEUS_URL=
ONPREM_GRAFANA_URL=
ONPREM_ALERTMANAGER_URL=
ONPREM_METRICS_AUTH_MODE=
ONPREM_LOG_AGGREGATION_TARGET=

# Transport note:
# If Socket.IO HTTP polling transport is enabled, sticky sessions are required at the LB/proxy.
# For validated WebSocket-only transport, sticky sessions are not required for transport stickiness.
# Regardless of transport mode, Valkey-backed fanout is required for multi-node notification routing.
#
# Signed auth canary note:
# Set DARSHAN_REALTIME_SIGNED_AUTH_ENABLED=true only for selected canary players.
# Keep DEVICE_SOCKET_LEGACY_AUTH_ALLOWED=true and DEVICE_SOCKET_SIGNED_AUTH_ENABLED=true on the backend.
# Keep DEVICE_SOCKET_AUTH_REPLAY_PROTECTION_ENABLED=true with DEVICE_SOCKET_AUTH_REPLAY_FAIL_CLOSED=false.
# Production realtime remains NOT_PRODUCTION_READY until Valkey, proxy, load, Node 20, and rollback gates pass.

# Rollback order:
# 0. DARSHAN_REALTIME_SIGNED_AUTH_ENABLED=false on canary players
# 0a. DEVICE_SOCKET_SIGNED_AUTH_ENABLED=false if optional signed socket auth causes auth rejects
# 0b. DEVICE_SOCKET_AUTH_REPLAY_PROTECTION_ENABLED=false if signed socket replay protection causes auth rejects
# 0c. Keep DEVICE_SOCKET_LEGACY_AUTH_ALLOWED=true for compatibility
# 1. OUTBOX_DISPATCH_ENABLED=false
# 2. REALTIME_SYNC_ENABLED=false
# 3. DARSHAN_REALTIME_PLAYER_ENABLED=false
# Polling and heartbeat fallback must remain enabled.
