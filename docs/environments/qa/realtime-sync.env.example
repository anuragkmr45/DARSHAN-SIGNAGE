# Signhex QA realtime sync environment checklist
# Values are examples. Do not store secrets in this file.

# Backend: source-of-truth REST, command lifecycle, desired state, and outbox writes.
COMMAND_LEASE_MS=60000
COMMAND_MAX_ATTEMPTS=5
COMMAND_DEFAULT_EXPIRES_MS=86400000
COMMAND_EMERGENCY_EXPIRES_MS=300000
COMMAND_OUTBOX_WRITE_ENABLED=true
DEVICE_DESIRED_STATE_ENABLED=true
MEDIA_CACHE_REPORTING_ENABLED=true

# Backend: notification-only WebSocket gateway and outbox dispatcher.
# Keep disabled until QA proxy smoke passes, then enable for canary only.
REALTIME_SYNC_ENABLED=false
REALTIME_DEVICE_NAMESPACE=/device
REALTIME_WS_PATH=/socket.io/
REALTIME_WS_PING_INTERVAL_MS=25000
REALTIME_WS_IDLE_TIMEOUT_MS=75000
WS_NOTIFICATION_MAX_BYTES=32768
OUTBOX_DISPATCH_ENABLED=false
OUTBOX_DISPATCH_BATCH_SIZE=100
OUTBOX_DISPATCH_INTERVAL_MS=1000
OUTBOX_DISPATCH_LEASE_MS=30000

# Backend: optional distributed fanout dependency.
# Leave blank when using a single backend instance.
REDIS_URL=
NATS_URL=

# CMS build-time flags.
VITE_REALTIME_DELIVERY_STATUS_UI=true
VITE_MEDIA_CACHE_STATUS_UI=true

# Player/runtime flags.
# Keep realtime disabled until the QA backend and proxy smoke checks pass.
HEXMON_REALTIME_SYNC_ENABLED=false
HEXMON_REALTIME_DEVICE_NAMESPACE=/device
HEXMON_REALTIME_WS_URL=wss://qa-backend.example.internal
HEXMON_REALTIME_COMMAND_SAFETY_POLL_MS=60000
HEXMON_REALTIME_FALLBACK_POLL_MS=30000
HEXMON_REALTIME_DESIRED_STATE_POLL_MS=300000
HEXMON_WS_NOTIFICATION_MAX_BYTES=32768
HEXMON_MEDIA_CACHE_REPORTING_ENABLED=true

# Rollback order:
# 1. OUTBOX_DISPATCH_ENABLED=false
# 2. REALTIME_SYNC_ENABLED=false
# 3. HEXMON_REALTIME_SYNC_ENABLED=false
# Polling and heartbeat fallback must remain enabled.
