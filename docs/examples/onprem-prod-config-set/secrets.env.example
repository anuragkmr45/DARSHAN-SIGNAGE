# Example only. Replace every placeholder locally and never commit real secrets.
DATABASE_URL=postgresql://<user>:<password>@<data-host>:5432/<db>
JWT_SECRET=<generate-strong-secret-min-32-chars>
ADMIN_EMAIL=<admin-email>
# Do not place ADMIN_PASSWORD in production env files.
# Provide the first-admin password as the one-shot mode-0600 bootstrap file:
#   backend/bootstrap-secrets/admin-password -> /run/darshan-bootstrap/admin-password
MINIO_ACCESS_KEY=<minio-access-key>
MINIO_SECRET_KEY=<minio-secret-key>
VALKEY_URL=redis://:<password>@<valkey-host>:6379/0
CA_CERT_PATH=<path-to-ca-crt>
CA_KEY_PATH=<path-to-ca-key>
OBSERVABILITY_METRICS_BEARER_TOKEN=<metrics-token>
