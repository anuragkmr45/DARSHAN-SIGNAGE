# A disposable PostgreSQL database used only by the backend Vitest suite.
# The runner refuses names that do not end in _test.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/darshan_test

# Optional. Defaults to the same host/user/password with database `postgres`.
# Set this when the test login cannot create databases.
# TEST_DATABASE_ADMIN_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
