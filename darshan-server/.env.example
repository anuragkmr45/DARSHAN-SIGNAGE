# DARSHAN backend env template.
# Copy to darshan-server/.env for development, QA, Docker production, or Proxmox production.
#
# Keep env short:
# - secrets stay here
# - sensitive URLs stay here
# - config-file selectors stay here
# - non-secret runtime/deployment values go in JSON config files
#
# Example non-secret backend config:
#   darshan-server/config/backend.production.example.json
#
# Production example:
#   cp darshan-server/.env.example darshan-server/.env
#   cp darshan-server/config/backend.production.example.json /etc/darshan/server/config.json
#   DARSHAN_CONFIG_FILE=/etc/darshan/server/config.json

# Runtime mode
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Optional backend JSON config selector. Env values override config file values.
# DARSHAN_* is preferred. SIGNHEX_* aliases still work but are left commented to avoid duplicate inputs.
DARSHAN_CONFIG_FILE=
DARSHAN_ENV=
# SIGNHEX_CONFIG_FILE=
# SIGNHEX_ENV=

# Process role. Production should normally run API + worker behavior.
DARSHAN_PROCESS_ROLE=all

# Database. DATABASE_URL is sensitive because it may contain a password.
# Docker data containers use POSTGRES_* in the deployment env; the backend app uses DATABASE_URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/darshan

# Auth/session secrets
JWT_SECRET=your-secret-key-min-32-chars-long-here
JWT_EXPIRY=900

# MinIO/object-storage credentials
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Admin bootstrap user. Change before production.
ADMIN_EMAIL=admin@darshan.local
ADMIN_PASSWORD=LocalDev@123

# Pairing CA/cert material paths. The files are sensitive and must not be committed.
CA_CERT_PATH=./certs/ca.crt
CA_KEY_PATH=./certs/ca.key

# Valkey URL is sensitive if it includes auth or TLS details. Required when config sets realtime.busProvider=valkey.
VALKEY_URL=
# REDIS_URL is a legacy compatibility alias. Prefer VALKEY_URL for new deployments.
# REDIS_URL=
# REDIS_URL_ALIAS_FOR_VALKEY=false

# Observability metrics bearer token, if metrics scraping is protected.
OBSERVABILITY_METRICS_BEARER_TOKEN=

# Optional runtime tool overrides. Leave blank when tools are on PATH.
FFMPEG_PATH=ffmpeg
LIBREOFFICE_PATH=soffice
PG_DUMP_PATH=pg_dump
TAR_PATH=tar
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
# DARSHAN_WEBPAGE_CAPTURE_EXECUTABLE_PATH=
# HEXMON_WEBPAGE_CAPTURE_EXECUTABLE_PATH=

# Emergency env overrides only. Prefer JSON config for these non-secret values.
# AUTH_COOKIE_SECURE=
# DEVICE_AUTH_MODE=legacy
# DEVICE_AUTH_SIGNATURE_MAX_SKEW_SECONDS=300
# CORS_ORIGINS=http://localhost:8080
# SOCKET_ALLOWED_ORIGINS=http://localhost:8080
# APP_PUBLIC_BASE_URL=http://localhost:8080
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_REGION=us-east-1
