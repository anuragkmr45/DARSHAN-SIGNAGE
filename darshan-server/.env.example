# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Docker published ports / container names
API_HOST_PORT=3000
API_CONTAINER_NAME=darshan-api

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=darshan
POSTGRES_HOST_PORT=5432
POSTGRES_CONTAINER_NAME=darshan-postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/darshan

# JWT
JWT_SECRET=your-secret-key-min-32-chars-long-here
JWT_EXPIRY=900

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_CONTAINER_NAME=darshan-minio
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

# Admin User (seed)
ADMIN_EMAIL=admin@darshan.local
ADMIN_PASSWORD=ChangeMe123!

# Pairing CA
CA_CERT_PATH=./certs/ca.crt

# Legacy / incomplete dedicated device TLS listener settings.
# The current supported runtime exposes the backend on PORT only.
# DEVICE_PORT=8443
# DEVICE_HOST_PORT=8443
# TLS_CERT_PATH=./certs/server.crt
# TLS_KEY_PATH=./certs/server.key

# Logging
LOG_LEVEL=info
ENABLE_SWAGGER_UI=true

# Runtime tools
FFMPEG_PATH=ffmpeg
LIBREOFFICE_PATH=soffice
PG_DUMP_PATH=pg_dump
TAR_PATH=tar
# Preferred DARSHAN name. Legacy HEXMON_WEBPAGE_CAPTURE_EXECUTABLE_PATH remains supported.
# DARSHAN_WEBPAGE_CAPTURE_EXECUTABLE_PATH=
# HEXMON_WEBPAGE_CAPTURE_EXECUTABLE_PATH=

# pg-boss
PG_BOSS_SCHEMA=pgboss

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=1000
RATE_LIMIT_TIME_WINDOW="1 minute"

# CORS / Socket.IO
CORS_ORIGINS=http://localhost:8080
SOCKET_ALLOWED_ORIGINS=http://localhost:8080
APP_PUBLIC_BASE_URL=http://localhost:8080

# Optional backward-compatible Redis-protocol URL.
# New on-prem realtime fanout deployments should prefer VALKEY_URL.
# REDIS_URL=redis://localhost:6379
# REDIS_URL_ALIAS_FOR_VALKEY=false

# Device command lifecycle
COMMAND_LEASE_MS=60000
COMMAND_MAX_ATTEMPTS=5
COMMAND_DEFAULT_EXPIRES_MS=86400000
COMMAND_EMERGENCY_EXPIRES_MS=300000
COMMAND_OUTBOX_WRITE_ENABLED=true
DEVICE_DESIRED_STATE_ENABLED=true

# Backend realtime notification gateway (notification-only; REST remains authoritative)
DARSHAN_REALTIME_SYNC_ENABLED=false
REALTIME_SYNC_ENABLED=false
REALTIME_DEVICE_NAMESPACE=/device
REALTIME_WS_PATH=/socket.io/
REALTIME_WS_PING_INTERVAL_MS=25000
REALTIME_WS_IDLE_TIMEOUT_MS=75000
REALTIME_SOCKET_TRANSPORT=websocket
REALTIME_SOCKET_ALLOW_POLLING=true
REALTIME_SOCKET_REQUIRE_STICKY_SESSIONS=false
DEVICE_SOCKET_LEGACY_AUTH_ALLOWED=true
DEVICE_SOCKET_SIGNED_AUTH_ENABLED=true
DEVICE_SOCKET_AUTH_MAX_CLOCK_SKEW_MS=300000
WS_NOTIFICATION_MAX_BYTES=32768
REALTIME_BUS_PROVIDER=memory
REALTIME_NODE_ID=
REALTIME_DEVICE_NODE_TTL_MS=120000
VALKEY_URL=
VALKEY_MODE=standalone
VALKEY_TLS_ENABLED=false
VALKEY_AUTH_REQUIRED=false
VALKEY_CA_CERT_PATH=
VALKEY_NAMESPACE=darshan:dev
VALKEY_PUBSUB_ENABLED=false
REALTIME_VALKEY_RECONNECT_MIN_MS=500
REALTIME_VALKEY_RECONNECT_MAX_MS=30000
REALTIME_VALKEY_PUBLISH_TIMEOUT_MS=1000
OUTBOX_DISPATCH_ENABLED=false
OUTBOX_DISPATCH_BATCH_SIZE=100
OUTBOX_DISPATCH_INTERVAL_MS=1000
OUTBOX_DISPATCH_LEASE_MS=60000

# Phase 6 media/cache failure reporting (REST only; no media/log payloads)
DARSHAN_MEDIA_CACHE_REPORTING_ENABLED=true
MEDIA_CACHE_REPORTING_ENABLED=true
