NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DEVICE_PORT=8443
# Optional CONFIG-1 backend JSON config file. Existing env vars override config file values.
DARSHAN_CONFIG_FILE=
SIGNHEX_CONFIG_FILE=
DARSHAN_ENV=qa
SIGNHEX_ENV=
# Secrets-file loading is an operator/process-manager concern in CONFIG-1.
# DARSHAN_SECRETS_FILE=
# SIGNHEX_SECRETS_FILE=

API_HOST_PORT=3000
API_CONTAINER_NAME=darshan-api

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=darshan
POSTGRES_HOST_PORT=5432
POSTGRES_CONTAINER_NAME=darshan-postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/darshan

JWT_SECRET=replace-this-with-a-secret-at-least-32-characters
JWT_EXPIRY=900
# Auth cookies are Secure by default when NODE_ENV=production.
# Set false only for isolated HTTP LAN QA; real production should use HTTPS and keep the default/true.
# AUTH_COOKIE_SECURE=false

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_CONTAINER_NAME=darshan-minio
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

ADMIN_EMAIL=admin@darshan.local
ADMIN_PASSWORD=LocalDev@123

TLS_CERT_PATH=./certs/server.crt
TLS_KEY_PATH=./certs/server.key
CA_CERT_PATH=./certs/ca.crt

LOG_LEVEL=info
ENABLE_SWAGGER_UI=true

FFMPEG_PATH=ffmpeg
LIBREOFFICE_PATH=soffice
PG_DUMP_PATH=pg_dump
TAR_PATH=tar
INSTALL_PLAYWRIGHT_CHROMIUM=false

PG_BOSS_SCHEMA=pgboss

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=1000
RATE_LIMIT_TIME_WINDOW=1 minute

CORS_ORIGINS=http://192.168.0.11:8080,http://localhost:8080
SOCKET_ALLOWED_ORIGINS=http://192.168.0.11:8080,http://localhost:8080
APP_PUBLIC_BASE_URL=http://192.168.0.11:8080
SIGNHEX_DEPLOYMENT_ID=qa-site-a
SIGNHEX_ENVIRONMENT_NAME=qa
SIGNHEX_SERVER_ID=darshan-api-qa-a
DUPLICATE_IDENTITY_DETECTION_ENABLED=true
DUPLICATE_IDENTITY_ENFORCEMENT=warn
DEVICE_SESSION_LEASE_MS=300000
DEVICE_SESSION_RESTART_GRACE_MS=120000
CSRF_ENABLED=true

PASSWORD_MIN_LENGTH=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_SECONDS=900

MAX_UPLOAD_MB=200
STORAGE_QUOTA_BYTES=0

OBSERVABILITY_METRICS_ENABLED=true
OBSERVABILITY_METRICS_BEARER_TOKEN=darshan-development-prometheus
OBSERVABILITY_DEPLOYMENT_MODE=qa
OBSERVABILITY_PROMETHEUS_BASE_URL=http://127.0.0.1:9090
OBSERVABILITY_PROMETHEUS_TIMEOUT_MS=1500
OBSERVABILITY_GRAFANA_ENABLED=true
OBSERVABILITY_GRAFANA_EMBED_ENABLED=true
OBSERVABILITY_GRAFANA_BASE_PATH=/grafana

COMMAND_LEASE_MS=60000
COMMAND_MAX_ATTEMPTS=5
COMMAND_DEFAULT_EXPIRES_MS=86400000
COMMAND_EMERGENCY_EXPIRES_MS=300000
COMMAND_OUTBOX_WRITE_ENABLED=true
DEVICE_DESIRED_STATE_ENABLED=true

DARSHAN_REALTIME_SYNC_ENABLED=false
REALTIME_SYNC_ENABLED=false
REALTIME_DEVICE_NAMESPACE=/device
REALTIME_WS_PATH=/socket.io/
REALTIME_WS_PING_INTERVAL_MS=25000
REALTIME_WS_IDLE_TIMEOUT_MS=75000
REALTIME_SOCKET_TRANSPORT=websocket
REALTIME_SOCKET_ALLOW_POLLING=true
REALTIME_SOCKET_REQUIRE_STICKY_SESSIONS=false
DEVICE_SOCKET_LEGACY_AUTH_ALLOWED=true
DEVICE_SOCKET_SIGNED_AUTH_ENABLED=true
DEVICE_SOCKET_AUTH_MAX_CLOCK_SKEW_MS=300000
# Signed socket replay protection uses Valkey when configured; fail-open preserves rollback safety.
DEVICE_SOCKET_AUTH_REPLAY_PROTECTION_ENABLED=true
DEVICE_SOCKET_AUTH_REPLAY_CACHE_TTL_MS=300000
DEVICE_SOCKET_AUTH_REPLAY_FAIL_CLOSED=false
WS_NOTIFICATION_MAX_BYTES=32768
REALTIME_BUS_PROVIDER=valkey
REALTIME_NODE_ID=
REALTIME_DEVICE_NODE_TTL_MS=120000
VALKEY_URL=
VALKEY_MODE=standalone
VALKEY_TLS_ENABLED=false
VALKEY_AUTH_REQUIRED=true
VALKEY_CA_CERT_PATH=
VALKEY_NAMESPACE=darshan:qa
VALKEY_PUBSUB_ENABLED=true
REALTIME_VALKEY_RECONNECT_MIN_MS=500
REALTIME_VALKEY_RECONNECT_MAX_MS=30000
REALTIME_VALKEY_PUBLISH_TIMEOUT_MS=1000
REDIS_URL=
REDIS_URL_ALIAS_FOR_VALKEY=true
OUTBOX_DISPATCH_ENABLED=false
OUTBOX_DISPATCH_BATCH_SIZE=100
OUTBOX_DISPATCH_INTERVAL_MS=1000
OUTBOX_DISPATCH_LEASE_MS=60000

DARSHAN_MEDIA_CACHE_REPORTING_ENABLED=true
