# DARSHAN backend production env for 5 Proxmox LXCs.
# Copy to darshan-server/.env and replace every CHANGE_ME_* value.

NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DARSHAN_PROCESS_ROLE=all

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=darshan
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_POSTGRES_PASSWORD@192.168.1.201:5432/darshan

JWT_SECRET=CHANGE_ME_STRONG_RANDOM_MIN_32_CHARS
JWT_EXPIRY=900
# AUTH_COOKIE_SECURE=true requires HTTPS. For isolated HTTP LAN QA only, set false.
AUTH_COOKIE_SECURE=false

MINIO_ENDPOINT=192.168.1.201
MINIO_PORT=9000
MINIO_ACCESS_KEY=CHANGE_ME_STRONG_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_STRONG_MINIO_SECRET_KEY
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

ADMIN_EMAIL=admin@darshan.local
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

CA_CERT_PATH=./certs/ca.crt
CA_KEY_PATH=./certs/ca.key

DEVICE_AUTH_MODE=legacy
DEVICE_AUTH_SIGNATURE_MAX_SKEW_SECONDS=300

LOG_LEVEL=info
ENABLE_SWAGGER_UI=false

FFMPEG_PATH=ffmpeg
LIBREOFFICE_PATH=soffice
PG_DUMP_PATH=pg_dump
TAR_PATH=tar
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

PG_BOSS_SCHEMA=pgboss

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=1000
RATE_LIMIT_TIME_WINDOW="1 minute"

CSRF_ENABLED=true
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_SECONDS=900
MAX_UPLOAD_MB=200
STORAGE_QUOTA_BYTES=0

CORS_ORIGINS=http://192.168.1.204:8080
SOCKET_ALLOWED_ORIGINS=http://192.168.1.204:8080
APP_PUBLIC_BASE_URL=http://192.168.1.204:8080

SIGNHEX_DEPLOYMENT_ID=site-a
SIGNHEX_ENVIRONMENT_NAME=production
SIGNHEX_SERVER_ID=backend-a
DUPLICATE_IDENTITY_DETECTION_ENABLED=true
DUPLICATE_IDENTITY_ENFORCEMENT=warn
DEVICE_SESSION_LEASE_MS=300000
DEVICE_SESSION_RESTART_GRACE_MS=120000

OBSERVABILITY_METRICS_ENABLED=true
OBSERVABILITY_METRICS_BEARER_TOKEN=CHANGE_ME_STRONG_RANDOM_METRICS_TOKEN
OBSERVABILITY_DEPLOYMENT_MODE=production
OBSERVABILITY_PROMETHEUS_BASE_URL=http://192.168.1.205:9090
OBSERVABILITY_PROMETHEUS_TIMEOUT_MS=1500
OBSERVABILITY_GRAFANA_ENABLED=true
OBSERVABILITY_GRAFANA_EMBED_ENABLED=true
OBSERVABILITY_GRAFANA_BASE_PATH=/grafana

COMMAND_LEASE_MS=60000
COMMAND_MAX_ATTEMPTS=5
COMMAND_DEFAULT_EXPIRES_MS=86400000
COMMAND_EMERGENCY_EXPIRES_MS=300000
COMMAND_OUTBOX_WRITE_ENABLED=true
DEVICE_DESIRED_STATE_ENABLED=true

DARSHAN_REALTIME_SYNC_ENABLED=true
REALTIME_SYNC_ENABLED=true
REALTIME_DEVICE_NAMESPACE=/device
REALTIME_WS_PATH=/socket.io/
REALTIME_WS_PING_INTERVAL_MS=25000
REALTIME_WS_IDLE_TIMEOUT_MS=75000
REALTIME_SOCKET_TRANSPORT=websocket
REALTIME_SOCKET_ALLOW_POLLING=true
REALTIME_SOCKET_REQUIRE_STICKY_SESSIONS=false
WS_NOTIFICATION_MAX_BYTES=32768

DEVICE_SOCKET_LEGACY_AUTH_ALLOWED=true
DEVICE_SOCKET_SIGNED_AUTH_ENABLED=true
DEVICE_SOCKET_AUTH_MAX_CLOCK_SKEW_MS=300000
DEVICE_SOCKET_AUTH_REPLAY_PROTECTION_ENABLED=true
DEVICE_SOCKET_AUTH_REPLAY_CACHE_TTL_MS=300000
DEVICE_SOCKET_AUTH_REPLAY_FAIL_CLOSED=false

REALTIME_BUS_PROVIDER=valkey
REALTIME_NODE_ID=backend-a
REALTIME_DEVICE_NODE_TTL_MS=120000
VALKEY_URL=redis://192.168.1.202:6379
VALKEY_MODE=standalone
VALKEY_TLS_ENABLED=false
VALKEY_AUTH_REQUIRED=false
VALKEY_CA_CERT_PATH=
VALKEY_NAMESPACE=darshan:production
VALKEY_PUBSUB_ENABLED=true
REALTIME_VALKEY_RECONNECT_MIN_MS=500
REALTIME_VALKEY_RECONNECT_MAX_MS=30000
REALTIME_VALKEY_PUBLISH_TIMEOUT_MS=1000

OUTBOX_DISPATCH_ENABLED=true
OUTBOX_DISPATCH_BATCH_SIZE=100
OUTBOX_DISPATCH_INTERVAL_MS=1000
OUTBOX_DISPATCH_LEASE_MS=60000

DARSHAN_MEDIA_CACHE_REPORTING_ENABLED=true
